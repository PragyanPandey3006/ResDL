# Flood-safe defaults for large batches (1000-2000 posts) on a single account.
# Keep concurrency low: one Telegram account running 100 simultaneous transfers
# is a guaranteed FloodWait/ban. These values trade a little speed for the
# ability to run huge batches unattended without getting rate-limited.
#   MAX_CONCURRENT_DOWNLOADS - simultaneous downloads/uploads (semaphore)
#   BATCH_SIZE               - posts dispatched per batch before pacing
#   FLOOD_WAIT_DELAY         - seconds slept between batches
MAX_CONCURRENT_DOWNLOADS = 3
BATCH_SIZE = 5
FLOOD_WAIT_DELAY = 8

# Optional: Auto-forward downloaded content to a channel/group
# Set to a chat ID (e.g., -1001234567890)
# Leave empty to disable auto-forwarding
FORWARD_CHAT_ID = -1004480244976
